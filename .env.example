# Local Docker / CLI only — CDP Portal injects these as secrets/env.
# Target environment: local | dev | test | perf-test | ext-test
ENVIRONMENT=perf-test

# Cognito OAuth2 client credentials (external-api / nfr-cap-10)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_OAUTH_BASE_URL=

# Organisation API code used as apiCode in POST /movements/receive
API_CODE=

# Optional override; defaults to:
# https://waste-movement-external-api.api.{ENVIRONMENT}.cdp-int.defra.cloud
# WASTE_MOVEMENT_EXTERNAL_API_BASE_URL=

# Bulk-upload (waste-movement-backend)
# SERVICE_AUTH_WASTE_ORGANISATION_BACKEND=   # Basic auth token (after "Basic ")
# CDP_API_KEY=
# CI=false                                  # true on CDP for direct backend host
# WASTE_MOVEMENT_BACKEND_BASE_URL=          # optional override

# CDP / local runner — external-api | nfr-cap-10 | bulk-upload
# PROFILE=external-api
# PROFILE=nfr-cap-10
# PROFILE=bulk-upload
